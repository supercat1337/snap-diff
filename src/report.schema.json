{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "File System Snapshot Diff (Forensic Version)",
  "type": "object",
  "oneOf": [
    {
      "title": "Metadata Header",
      "required": ["record_type", "version", "scan_start", "filters", "comparison"],
      "properties": {
        "record_type": { "const": "metadata" },
        "version": { "type": "string" },
        "scan_start": { "type": "integer" },
        "filters": {
          "type": "object",
          "required": ["excludePaths", "excludeCols", "includeCols", "resolveNames"],
          "properties": {
            "excludePaths": { "type": "array", "items": { "type": "string" } },
            "excludeCols": { "type": "array", "items": { "type": "string" } },
            "includeCols": { "type": "array", "items": { "type": "string" } },
            "resolveNames": { "type": "boolean" }
          }
        },
        "comparison": {
          "type": "object",
          "required": ["new", "old"],
          "properties": {
            "new": { "$ref": "#/definitions/snapshot_info" },
            "old": { "$ref": "#/definitions/snapshot_info" }
          }
        }
      }
    },
    {
      "title": "Change Record",
      "required": ["record_type", "status", "path", "file_type"],
      "properties": {
        "record_type": { "const": "entry" },
        "status": { "enum": ["ADDED", "MODIFIED", "DELETED", "RENAMED"] },
        "path": { "type": "string" },
        "file_type": { "enum": ["file", "dir", "link"] },
        "diff": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["old", "new"],
            "properties": {
              "old": { "type": ["string", "number", "null"] },
              "new": { "type": ["string", "number", "null"] }
            }
          }
        }
      }
    },
    {
      "title": "Summary Footer",
      "required": ["record_type", "stats", "scan_start", "scan_end"],
      "properties": {
        "record_type": { "const": "summary" },
        "scan_start": { "type": "integer" },
        "stats": {
          "type": "object",
          "required": ["added", "modified", "deleted", "renamed", "total"],
          "properties": {
            "added": { "type": "integer", "minimum": 0 },
            "modified": { "type": "integer", "minimum": 0 },
            "deleted": { "type": "integer", "minimum": 0 },
            "renamed": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          }
        },
        "scan_end": { "type": "integer" }
      }
    }
  ],
  "definitions": {
    "snapshot_info": {
      "type": "object",
      "required": ["name", "file", "version", "content_hash", "scan_start", "scan_end"],
      "properties": {
        "name": { "type": "string" },
        "file": { "type": "string" },
        "version": { "type": "string" },
        "content_hash": { "type": "string" },
        "scan_start": { "type": "integer" },
        "scan_end": { "type": "integer" }
      }
    }
  }
}